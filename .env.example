# Copy to .env ONLY for local command-line work (e.g. `npx supabase secrets set --env-file .env`).
# .env is ignored by git. Never commit real values. Never paste these into web/config.js.
#
# ---- Secrets for the Edge Functions (set with `npx supabase secrets set --env-file .env`) ----------
# Gemini key from https://aistudio.google.com/apikey  (a SECRET: it only ever lives here)
GEMINI_API_KEY=
# Exact model ID from https://ai.google.dev/gemini-api/docs/models (e.g. a "flash-lite" model).
# No default on purpose: model names change, and an unavailable name must fail loudly.
GEMINI_MODEL=
# Optional. A stronger model (free on your plan) used only by "Solve with AI". Empty = use GEMINI_MODEL.
GEMINI_SOLVE_MODEL=
# Which AI connector to use. Only "gemini" ships today (see "Adding another AI" in the README).
AI_PROVIDER=gemini
# Your own cap on image reads per day. Keep it below Google's free daily limit for your model.
AI_DAILY_LIMIT=20
# Websites allowed to call the functions from a browser. "*" is fine (bearer tokens, no cookies);
# tighten to your site once it is live, e.g. https://question-bank.yourname.workers.dev
ALLOWED_ORIGINS=*
# New questions pause at this database size (MB); the Supabase Free plan limit is 500.
DB_SOFT_LIMIT_MB=450
# Optional. Only if Supabase stops injecting SUPABASE_PUBLISHABLE_KEYS / SUPABASE_ANON_KEY:
# QB_PUBLISHABLE_KEY=sb_publishable_...
#
# ---- NOT secrets: these two go into web/config.js (they are meant to be public) ------------------
# Supabase project URL: https://<project-ref>.supabase.co
# Supabase publishable key (sb_publishable_...): Project Settings -> API Keys
#
# Never use the "secret" or "service_role" key anywhere in this project.
